<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <!-- Agent avatar -->
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="4dp">

        <View
            android:id="@+id/view_avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/shape_agent_avatar"
            android:backgroundTint="#E8D92F" />

        <TextView
            android:id="@+id/tv_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="W"
            android:textSize="12sp"
            android:textColor="#383838"
            android:fontFamily="@font/inter_semibold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:maxWidth="260dp">

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_message_agent"
            android:text=""
            android:textSize="15sp"
            android:textColor="#333333"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:lineSpacingMultiplier="1.35" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:41"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
